# Supabase project (Settings > API). Service-role key is SECRET: server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the Yjs relay. Local dev: ws://localhost:1234.
# Production: wss://<relay-host>  (without it the client falls back to localhost)
NEXT_PUBLIC_WS_URL=wss://your-relay.onrender.com

# Relay only (optional): listen port. Render sets PORT itself.
# PORT=1234
